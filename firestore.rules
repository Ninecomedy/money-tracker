rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validMoney(n) {
      return n is number && n >= 0 && n <= 1000000000000;
    }
    function validSavingsTransfer(uid) {
      let transfer = request.resource.data;
      let settingsPath = /databases/$(database)/documents/users/$(uid)/settings/main;
      return transfer.keys().hasOnly(['direction', 'amount', 'before', 'after', 'date'])
        && transfer.keys().hasAll(['direction', 'amount', 'before', 'after', 'date'])
        && validMoney(transfer.amount) && transfer.amount > 0
        && validMoney(transfer.before) && validMoney(transfer.after)
        && transfer.date is string && transfer.date.size() <= 30
        && transfer.before == get(settingsPath).data.reserve
        && transfer.after == getAfter(settingsPath).data.reserve
        && ((transfer.direction == 'add' && math.round(transfer.after * 100) == math.round(transfer.before * 100) + math.round(transfer.amount * 100))
          || (transfer.direction == 'remove' && math.round(transfer.after * 100) == math.round(transfer.before * 100) - math.round(transfer.amount * 100)));
    }
    match /users/{uid}/savingsTransfers/{transferId} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validSavingsTransfer(uid);
      allow update, delete: if false;
    }
    match /users/{uid}/settings/{settingsId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['opening', 'reserve', 'updatedAt'])
        && request.resource.data.keys().hasAll(['opening', 'reserve', 'updatedAt'])
        && validMoney(request.resource.data.opening)
        && validMoney(request.resource.data.reserve)
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 30;
      allow delete: if owner(uid);
    }
    match /users/{uid}/entries/{entryId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['type', 'amount', 'note', 'category', 'date'])
        && request.resource.data.keys().hasAll(['type', 'amount', 'note', 'category', 'date'])
        && (request.resource.data.type == 'income' || request.resource.data.type == 'expense')
        && validMoney(request.resource.data.amount)
        && request.resource.data.amount > 0
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 100
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 30;
      allow delete: if owner(uid);
    }
  }
}
